ggplot(pefr_long, aes(x = Period, y = Mean_PEFR, group = ID_in_group)) +
geom_line() +
geom_point(size = 1) +
facet_wrap(~ Group) +
scale_x_continuous(breaks = c(1, 2))
ggplot(group_period_means, aes(x = Period, y = Mean_PEFR)) +
geom_line(aes(group = ifelse(Treatment_Period %in% c("1A", "2A"), "A", "B")),
size = 1) +
geom_point(size = 3, shape = 5) +
geom_text(aes(label = Treatment_Period),
nudge_y = 2, size = 3.5)
group_period_means = pefr |>
group_by(Group) |>
summarise(
Period_1_mean = mean(Period_1),
Period_2_mean = mean(Period_2),
.group = "drop"
) |>
pivot_longer(
cols = c(Period_1_mean, Period_2_mean),
names_to = "Period",
values_to = "Mean_PEFR"
) |>
mutate(
Period = case_when(
Period == "Period_1_mean" ~ 1,
Period == "Period_2_mean" ~ 2
),
Treatment_Period = case_when(
Group == "AB" & Period == 1 ~ "1A",
Group == "AB" & Period == 2 ~ "1B",
Group == "BA" & Period == 1 ~ "2B",
Group == "BA" & Period == 2 ~ "2A"
)
)
ggplot(group_period_means, aes(x = Period, y = Mean_PEFR)) +
geom_line(aes(group = ifelse(Treatment_Period %in% c("1A", "2A"), "A", "B")),
size = 1) +
geom_point(size = 3, shape = 5) +
geom_text(aes(label = Treatment_Period),
nudge_y = 2, size = 3.5)
